# ==========================================
# OpenCode Specific
# ==========================================
# Ignore OpenCode's dynamic package/model caches, but do NOT ignore configurations or custom skills
.opencode/cache/

# ==========================================
# Secrets & Environment Variables
# ==========================================
# Never commit your local credentials or private API keys if you add them later
.env
.env.local
.env.*
!.env.example

# ==========================================
# Editor Cruft (VS Code & OS Noise)
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
.opencode

# ==========================================
# Package Manager / Runtimes (If using Bun/Node plugins)
# ==========================================
node_modules/
.cache/
.npm/

# ==========================================
# STE-specific exclusions
# ==========================================
# Obsidian internals (keep .obsidian/app.json and .obsidian/plugins as config)
.obsidian/workspace*
.obsidian/cache

# Personal user files — machine-local only, never commit
# Convention: members/<github-username>.md
members/*.md

# Root USER.md is now a pointer file — keep it committed (it's just a redirect)
# If you accidentally filled out USER.md with personal data, gitignore it here:
# USER.md

# Copilot session logs (large, ephemeral — not useful in repo history)
copilot/copilot-conversations/

# Setup secrets scripts (contain vault commands, not for public repo)
scripts/setup-secrets.sh
scripts/recover-credentials.md

# ==========================================
# OP#561 — Zero Private Data in Git (wiki rule)
# ==========================================
# Auto-generated transcript chunks
chunks/

# Session memory files (generated, not governance)
Memory/

# Obsidian plugin binaries
.obsidian/plugins/

# Personal user files (gitignored by design)
USER.md
members/*.md
!members/README.md
!members/template.yaml
!members/devices.yaml

# Staging area — should be cleared after intake
_incoming/*.md

# Agent workspace artifacts
Project TigersClaws*.csv
*.csv

# Environment/secrets (should already be here)
.env
*.env
~/.ste-secrets/

# Python cache
__pycache__/
*.pyc

# Node modules (skills/composio-integration)
skills/composio-integration/node_modules/
skills/composio-integration/package-lock.json
